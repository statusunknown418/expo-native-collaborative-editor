{
  "name": "expo-native-collaborative-editor-example",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/ui": "~57.0.23",
    "expo": "~57.0.28",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild --platform ios",
    "ios": "expo run:ios --device \"$npm_package_config_simulator\"",
    "test:ios:unit": "xcodebuild test -quiet -workspace ios/exponativecollaborativeeditorexample.xcworkspace -scheme ExpoNativeCollaborativeEditor-Unit-Tests -destination \"platform=iOS Simulator,name=$npm_package_config_simulator,OS=$npm_package_config_simulatorOS\"",
    "test:ios:ui": "xcodebuild test -quiet -workspace ios/exponativecollaborativeeditorexample.xcworkspace -scheme exponativecollaborativeeditorexample -configuration Release -destination \"platform=iOS Simulator,name=$npm_package_config_simulator,OS=$npm_package_config_simulatorOS\""
  },
  "config": {
    "simulator": "iPhone 17 Pro",
    "simulatorOS": "26.2"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
}
