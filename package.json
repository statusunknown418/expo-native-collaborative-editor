{
  "name": "expo-native-collaborative-editor",
  "version": "0.1.0",
  "description": "Native-first collaborative editor, no expo-dom, plug and play adapters for sync engines",
  "keywords": [
    "react-native",
    "expo",
    "expo-native-collaborative-editor",
    "ExpoNativeCollaborativeEditor"
  ],
  "homepage": "https://github.com/statusunknown418/expo-native-collaborative-editor#readme",
  "bugs": {
    "url": "https://github.com/statusunknown418/expo-native-collaborative-editor/issues"
  },
  "repository": "https://github.com/statusunknown418/expo-native-collaborative-editor",
  "license": "MIT",
  "author": "statusunknown418 <alvaro@stackkstudios.com> (https://github.com/statusunknown418)",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "dev": "bun run --parallel dev:module dev:example",
    "dev:example": "bun run --cwd example ios",
    "dev:module": "bun run build --watch",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint-staged": "lint-staged",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "prepare": "node internal/module_scripts/prepare.js && husky",
    "test": "node internal/module_scripts/test.js"
  },
  "lint-staged": {
    "*": "ultracite fix"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@biomejs/biome": "2.5.15",
    "@expo/ui": "~57.0.23",
    "@types/bun": "1.4.3",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.15",
    "expo": "~57.0.28",
    "husky": "9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "lint-staged": "17.6.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "~6.0.3",
    "ultracite": "8.0.1",
    "yjs": "13.6.33"
  },
  "peerDependencies": {
    "@expo/ui": "~57.0.23",
    "expo": "~57.0.28",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
